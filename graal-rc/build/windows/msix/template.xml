<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="graal-rc.exe"
        Arguments=""
        InstallLocation="C:\Program Files\RuanFernandes\Graal Remote Control">
    </Installer>
    <PackageInformation
        PackageName="Graal Remote Control"
        PackageDisplayName="Graal Remote Control"
        PublisherName="CN=RuanFernandes"
        PublisherDisplayName="RuanFernandes"
        Version="5.2.3.0"
        PackageDescription="Graal Remote Control client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.rauanf.graalrc"
                Description="Graal Remote Control client"
                DisplayName="Graal Remote Control"
                ExecutableName="graal-rc.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Graal Remote Control</DisplayName>
            <PublisherDisplayName>RuanFernandes</PublisherDisplayName>
            <Description>Graal Remote Control client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="graal-rc.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
